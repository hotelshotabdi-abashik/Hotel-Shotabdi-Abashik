# Cloudflare R2 Configuration
# Get Account ID from Cloudflare Dashboard -> R2 -> Account Details -> Account ID
R2_ACCOUNT_ID=
# Get these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The name of your R2 bucket (e.g., hotel-shotabdi-assets)
R2_BUCKET_NAME=hotel-shotabdi-assets
# The Public Development URL from your bucket settings (e.g., https://pub-xxx.r2.dev)
R2_PUBLIC_URL=

# Optional: R2 Worker Proxy (if using a worker to handle uploads)
# Example: https://hotel-cms-worker.hotelshotabdiabashik.workers.dev
R2_WORKER_URL=
R2_WORKER_AUTH_KEY=

# EmailJS Configuration (Notifications)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Firebase Cloud Messaging
VITE_FIREBASE_VAPID_KEY=BMYSFivUjrkvc9y3v3f5xulgbXY0wXtPKl7HSco62Vky4icfBopDXzWBXZ73x2n3T5R_2iX5JoiCz3fY7yUCemk
