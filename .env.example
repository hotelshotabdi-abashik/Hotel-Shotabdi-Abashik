# Cloudflare R2 Configuration
# Get Account ID from Cloudflare Dashboard -> R2 -> Account Details -> Account ID
R2_ACCOUNT_ID=
# Get these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The name of your R2 bucket (e.g., shotabdi-abashik)
R2_BUCKET_NAME=
# The Public Development URL from your bucket settings (e.g., https://pub-xxx.r2.dev)
R2_PUBLIC_URL=

# EmailJS Configuration (Notifications)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Firebase Cloud Messaging
VITE_FIREBASE_VAPID_KEY=
