rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- AUTHENTICATION HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      // Safely fetch the role from the roles collection
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role;
    }

    function isOwner() {
      return request.auth.token.email == 'hotelshotabdiabashik@gmail.com' || 
             (isSignedIn() && getRole() == 'owner');
    }

    function isManager() {
      return isSignedIn() && getRole() == 'manager';
    }

    // Admins include both Owner and Manager roles
    function isAdmin() {
      return isOwner() || isManager();
    }

    // --- COLLECTION RULES ---

    // Site Configuration: Rooms, restaurants, and global settings
    match /site-config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs: Historical records of admin actions
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // User Profiles: Resident information
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (request.auth.uid == uid);
      allow delete: if isOwner();
    }

    // Roles Collection: The core of the permission system
    // Managers can READ roles to see who is who, but only OWNERS can SWITCH roles.
    match /roles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isOwner(); 
    }

    // Usernames Registry: Ensuring unique handles
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if isSignedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Bookings: Stays and Registry records
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid && 
        resource.data.status == 'pending' &&
        resource.data.hasEdited == false
      );
      allow delete: if isAdmin();
    }

    // Help Desk: Live resident support
    match /help_dex/{document=**} {
      allow read, write: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId);
    }
  }
}