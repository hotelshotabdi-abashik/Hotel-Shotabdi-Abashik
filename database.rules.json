        ".write": "(!data.exists() && newData.child('userId').val() === auth.uid) || root.child('roles').child(auth.uid).val() === 'owner' || root.child('roles').child(auth.uid).val() === 'manager' || auth.token.email === 'hotelshotabdiabashik@gmail.com'"
